# Copy to .env and change the secrets before sharing the app with anyone.
WEB_PORT=3000
DB_PASSWORD=bookshare
JWT_SECRET=change-me-please-use-a-long-random-secret-of-at-least-32-bytes
ADMIN_EMAIL=admin@bookshare.local
ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# Photo storage: "local" (default, kept in the uploads volume) or "cloudinary" (free tier works)
STORAGE_TYPE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
